# Environment Variables

Copy this file to `.env` and fill in the values before running.

# MongoDB connection string (required)
# Local:   mongodb://localhost:27017/lifetrack
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/lifetrack
MONGODB_URI=mongodb://localhost:27017/lifetrack

# JWT signing secret — generate a long random string for production
# e.g.  openssl rand -hex 64
JWT_SECRET=replace-this-with-a-long-random-secret

# Your deployed Vercel frontend URL (required in production for CORS)
# e.g.  https://life-os-ui-beta.vercel.app
FRONTEND_URL=http://localhost:5173

# Set to 'production' when deploying
NODE_ENV=development

# Port the server listens on (defaults to 3001)
PORT=3001

